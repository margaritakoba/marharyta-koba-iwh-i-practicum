
doctype html
html
    head
        title= title
        meta(charset="utf-8")
        meta(name="viewport", content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Music Albums
        p Albums retrieved from HubSpot CRM.
        a.btn(href="/update-cobj") Add a new album

        if data.length
            table
                thead
                    tr
                        th Name
                        th Artist
                        th Genre
                        th Release Year
                        th Fans
                tbody
                    each album in data
                        tr
                            td= album.properties.name
                            td= album.properties.artist
                            td= album.properties.genre
                            td= album.properties.release_year
                            td
                                if album.contacts && album.contacts.length
                                    each contact in album.contacts
                                        div= contact.name
                                else
                                    span No contacts linked
        else
            p No albums found.